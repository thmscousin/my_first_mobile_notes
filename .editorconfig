root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.bat]
end_of_line = crlf

[*.{kt,kts}]
ktlint_code_style = android_studio
# Les fonctions @Composable s'écrivent en PascalCase.
ktlint_function_naming_ignore_when_annotated_with = Composable
